# CSULB Grad Center AI Assistant — environment variables
# Copy this file to .env and fill in values for your environment.
# Never commit .env — it is listed in .dockerignore.
#
# All variables below are optional: the application runs in its default
# (non-LLM) mode without any of them set.

# ── LLM Integration (Ollama) ──────────────────────────────────────────────────
# Set to "true" to enable AI-generated answer synthesis.
# Requires Ollama running at OLLAMA_BASE_URL with LLM_SYNTHESIS_MODEL pulled.
LLM_SYNTHESIS_ENABLED=false

# Set to "true" to enable AI-generated recommendation explanations.
# Same Ollama requirement as LLM_SYNTHESIS_ENABLED.
LLM_EXPLANATION_ENABLED=false

# URL of the Ollama server.
#   Local dev (host machine, outside Docker): http://localhost:11434
#   Inside Docker on macOS / Windows:         http://host.docker.internal:11434
#   Inside Docker on Linux:                   http://172.17.0.1:11434
#   Remote Ollama server:                     http://<host>:<port>
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model used for both synthesis and explanation.
# Pull on the Ollama host with: ollama pull qwen2.5:7b-instruct
LLM_SYNTHESIS_MODEL=qwen2.5:7b-instruct

# Maximum seconds to wait for a single LLM API call before timing out.
LLM_SYNTHESIS_TIMEOUT_S=30
